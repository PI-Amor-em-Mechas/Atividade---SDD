# O launcher copia este modelo para .env na raiz do projeto.
# Ambiente do processo > .env > launcher.env legado > padrões do script.
# Descomente as chaves que precisar configurar ou use o assistente MySQL.
# O MySQL/MariaDB pode estar no Windows, em uma VM ou em um servidor remoto.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=amor_em_mechas
# DB_USER=rastreamento_app
# DB_PASSWORD=

# SPRING_PORT=8080
# FRONTEND_PORT=5173
# STUB_PORT=8081
# STARTUP_TIMEOUT_SECONDS=180
# STOP_TIMEOUT_SECONDS=12
# TRACKING_TIMEOUT_SECONDS=10
# POLL_INTERVAL_SECONDS=5
# Demonstração sempre usa o stub local e limpa TRACKING_API_TOKEN.
