{
  "name": "mock-api-rastreamento",
  "version": "1.0.0",
  "private": true,
  "description": "API mock de rastreamento de encomendas utilizando JSON Server",
  "scripts": {
    "start": "json-server --watch db.json --routes routes.json --port 3001",
    "start:dev": "json-server --watch db.json --routes routes.json --port 3001 --delay 500"
  },
  "devDependencies": {
    "json-server": "^0.17.4"
  }
}
